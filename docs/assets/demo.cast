{"version":3,"term":{"cols":80,"rows":24},"timestamp":1790056786,"command":"/tmp/jevalaya-demo.sh","env":{"SHELL":"/bin/zsh"}}
[0.261, "o", "\u001b[1;35mjevalaya — one endpoint, three backends, honest receipts\u001b[0m\r\n"]
[1.155, "o", "\r\n\u001b[1;36m$ curl :8767/health\u001b[0m\r\n"]
[1.100, "o", "  backends: ['ane', 'mlx', 'jev']\r\n"]
[0.003, "o", "\r\n\u001b[1;36m$ POST /predict  (short request -> Neural Engine)\u001b[0m\r\n"]
[1.055, "o", "  answers: {\"topic\": {\"type\": \"choice\", \"confidence\": 0.998, \"choice\": \"shipping\", \"probabilities\": {\"billing\": 0.0, \"shipping\": 0.9998, \"support\": 0.0002}, \"act\r\n  backend=ane checkpoint=multilingual reason=ane_fit_multilingual: single prompt fits the ANE token budget; checkpoint=multilingual (detector: English Latin text)\r\n  conf=0.998 margin=0.9996 latency=61ms escalated=False\r\n"]
[1.214, "o", "\r\n\u001b[1;36m$ POST /predict  (English short -> also ANE, fit decides not the detector)\u001b[0m\r\n"]
[1.113, "o", "  answers: {\"topic\": {\"type\": \"choice\", \"confidence\": 0.9998, \"choice\": \"billing\", \"probabilities\": {\"billing\": 1.0, \"shipping\": 0.0, \"support\": 0.0}, \"action\": \r\n  backend=ane checkpoint=multilingual reason=ane_fit_multilingual: single prompt fits the ANE token budget; checkpoint=multilingual (detector: English Latin text)\r\n  conf=0.9998 margin=1.0 latency=28ms escalated=False\r\n"]
[1.218, "o", "\r\n\u001b[1;36m$ POST /predict  (score + noul -> MLX, multi-question)\u001b[0m\r\n"]
[2.236, "o", "  answers: {\"sev\": {\"type\": \"score\", \"score\": 1.99, \"confidence\": 0.99, \"legend\": {\"0\": \"trivial\", \"1\": \"annoying\", \"2\": \"unusable\"}, \"probabilities\": {\"0\": 0.0,\r\n  backend=jev checkpoint=english reason=question_count: English Latin text: escalated to jev\r\n  conf=0.99 margin=0.76 latency=1139ms escalated=True\r\n"]
[1.337, "o", "\r\n\u001b[1;36m$ POST /predict backend=jev  (explicit escalation -> TypeSafe)\u001b[0m\r\n"]
[1.385, "o", "  answers: {\"topic\": {\"type\": \"choice\", \"choice\": \"billing\", \"confidence\": 1.0, \"probabilities\": {\"billing\": 1.0, \"shipping\": 0.0}}}\r\n  backend=jev checkpoint=None reason=explicit_backend: backend=jev\r\n  conf=1.0 margin=1.0 latency=294ms escalated=False\r\n"]
[1.221, "o", "\r\n\u001b[1;36m$ POST /feedback  (consumer verdict -> JSONL sink)\u001b[0m\r\n"]
[1.067, "o", "{\"ok\":true}"]
[0.001, "o", "\r\n"]
[0.000, "o", "\r\n\u001b[1;32mlocal when it's sure — Jev when it isn't\u001b[0m\r\n"]
